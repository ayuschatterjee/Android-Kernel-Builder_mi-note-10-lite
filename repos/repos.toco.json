[
  {
    "kernelSource": {
      "name": "AyusKernel",
      "repo": "https://github.com/LineageOS/android_kernel_oneplus_sm8150",
      "branch": "lineage-22.1",
      "device": "sm8150",
      "defconfig": "lineage_sm8150_defconfig"
    },
    "withKernelSU": true,
    "withSUSFS": true,
    "withLXC": false,
    "toolchains": [
      {
        "name": "clang",
        "url": "https://github.com/devnoname120/android_prebuilts_clang-standalone/releases/download/linux-x86-refs_heads_android15-qpr2-release-clang-r530567/linux-x86-refs_heads_android15-qpr2-release-clang-r530567.tar.gz",
        "binPath": ["./bin"]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "externalCommand": {
        "LLVM": "1",
        "CROSS_COMPILE": "aarch64-linux-gnu-",
        "EXTRAVERSION": "-perf"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/khalidaboelmagd/AnyKernel3",
      "branch": "master"
    }
  }
]
